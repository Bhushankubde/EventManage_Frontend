# .gitignore for event-frontend service
# -------------------------------------------------
# Node modules (auto‑generated)
# -------------------------------------------------
node_modules/

# Dependency lock files (optional – keep if you want to version them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Build / distribution artifacts
# -------------------------------------------------
/dist/
/build/
/.next/
.out/
.svelte-kit/
.nuxt/

# Temporary / cache directories
# -------------------------------------------------
.cache/
.tmp/

# Environment files – NEVER commit secrets
# -------------------------------------------------
.env
.env.*
.env.*.local

# IDE / editor settings
# -------------------------------------------------
.idea/
.vscode/
*.suo
*.user
*.iml
*.iws
*.ipr

# OS generated files
# -------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# Logs and runtime artifacts
# -------------------------------------------------
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Miscellaneous secret/key files
# -------------------------------------------------
*.pem
*.crt
*.key
*.jks
*.p12
*.pfx
